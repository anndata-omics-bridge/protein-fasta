[importlinter]
root_packages =
    protein_fasta
include_external_packages = True

[importlinter:contract:package-tree]
name = Public products and composition modules depend inward
type = layers
containers =
    protein_fasta
exhaustive = True
layers =
    cli
    candidate_analysis | database_build | decoy_database | decoy_report | diagnostic_summary | peptide_workflow | protein_input | uniprot_download | uniprot_catalog
    database_compile | decoy_compile | registry_workflow
    peptide
    registry
    inventory | record | frame | summary | artifact_io | uniprot
    database
    analytics_compile
    compile | frame_compile | documents
    analytics | reading | validation | diagnostics | frame_formats | schema

[importlinter:contract:registry-backend]
name = Registry backend dependencies point inward
type = layers
containers =
    protein_fasta.registry.backend
exhaustive = True
layers =
    factory
    sqlite | duckdb
    base | schema

[importlinter:contract:database-components]
name = Database runtime components depend inward
type = layers
containers =
    protein_fasta.database
exhaustive = True
layers =
    decoy_advanced | entrapment_advanced
    decoy | entrapment | metadata | models | naming

[importlinter:contract:registry-components]
name = Registry queries depend on independent backend and kind values
type = layers
containers =
    protein_fasta.registry
exhaustive = True
layers =
    clustering
    comparisons
    indexing
    export | pair_metrics | snapshots | classification | metadata
    backend | filenames | kinds | rules

[importlinter:contract:reading-components]
name = FASTA serialization depends inward on lexical records
type = layers
containers =
    protein_fasta.reading
exhaustive = True
layers =
    writer
    parser | header

[importlinter:contract:uniprot-components]
name = UniProt acquisition and resolution depend on provider mechanics
type = layers
containers =
    protein_fasta.uniprot
exhaustive = True
layers =
    acquisition | resolution
    provider_rows | queries | transport
    models

[importlinter:contract:peptide-components]
name = Peptide executors depend on backend-free computation and models
type = layers
containers =
    protein_fasta.peptide
exhaustive = True
layers =
    executors
    computation
    models

[importlinter:contract:frame-formats-tree]
name = Polars frame operations depend only on runtime values
type = layers
containers =
    protein_fasta.frame_formats
exhaustive = True
layers =
    classification | detection | extraction
    runtime

[importlinter:contract:schema-tree]
name = Schema documents share only their strict base
type = layers
containers =
    protein_fasta.schema
exhaustive = True
layers =
    registry
    decoy_report
    build | candidate | decoy | peptide | protein_input
    uniprot
    artifacts
    analytics | diagnostics | frame_formats
    base

[importlinter:contract:scalar-runtime-framework-isolation]
name = Scalar runtime children do not import storage or frame frameworks
type = forbidden
source_modules =
    protein_fasta.reading
    protein_fasta.validation
    protein_fasta.diagnostics
forbidden_modules =
    pydantic
    polars
    pandas
    numpy
    anndata
    mudata
    anndata_proteomics
    fasta_gen
    prozor

[importlinter:contract:consumer-isolation]
name = The shared package imports no consuming application
type = forbidden
source_modules =
    protein_fasta
forbidden_modules =
    fasta_gen
    prozor
    apb
    apb2

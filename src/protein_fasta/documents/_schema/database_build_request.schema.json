{
  "$defs": {
    "DescriptionDocument": {
      "additionalProperties": false,
      "description": "Rules for deriving a compact database-description token.",
      "properties": {
        "mode_flags": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Mode Flags",
          "type": "object"
        }
      },
      "title": "DescriptionDocument",
      "type": "object"
    },
    "DigestionDocument": {
      "additionalProperties": false,
      "description": "Peptide-length and missed-cleavage limits for one enzyme.",
      "properties": {
        "enzyme": {
          "default": "trypsin",
          "title": "Enzyme",
          "type": "string"
        },
        "max_length": {
          "default": 50,
          "minimum": 1,
          "title": "Max Length",
          "type": "integer"
        },
        "min_length": {
          "default": 7,
          "minimum": 1,
          "title": "Min Length",
          "type": "integer"
        },
        "missed_cleavages": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Missed Cleavages",
          "type": "integer"
        }
      },
      "title": "DigestionDocument",
      "type": "object"
    },
    "ForeignSpeciesEntrapmentDocument": {
      "additionalProperties": false,
      "description": "Request entrapment proteins selected from prepared foreign-source rows.",
      "properties": {
        "digestion": {
          "$ref": "#/$defs/DigestionDocument"
        },
        "fold": {
          "default": 1,
          "maximum": 10,
          "minimum": 1,
          "title": "Fold",
          "type": "integer"
        },
        "normalize_i_to_l": {
          "default": false,
          "title": "Normalize I To L",
          "type": "boolean"
        },
        "reject_shared_foreign": {
          "default": true,
          "title": "Reject Shared Foreign",
          "type": "boolean"
        },
        "seed": {
          "default": 2000,
          "title": "Seed",
          "type": "integer"
        },
        "type": {
          "const": "foreign_species",
          "default": "foreign_species",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "ForeignSpeciesEntrapmentDocument",
      "type": "object"
    },
    "MetadataDocument": {
      "additionalProperties": false,
      "description": "Configured database metadata and contaminant-marker record grammar.",
      "properties": {
        "body_sequence": {
          "default": "CRAPCRAPCRAP",
          "title": "Body Sequence",
          "type": "string"
        },
        "date_format": {
          "default": "%Y-%m-%d",
          "title": "Date Format",
          "type": "string"
        },
        "id_namespace": {
          "default": "aa",
          "title": "Id Namespace",
          "type": "string"
        },
        "installer": {
          "default": "",
          "title": "Installer",
          "type": "string"
        },
        "marker_body_sequence": {
          "default": "MRECRAPCRAPCRAP",
          "title": "Marker Body Sequence",
          "type": "string"
        },
        "org": {
          "default": "fgcz",
          "title": "Org",
          "type": "string"
        },
        "provenance_template": {
          "default": "generated w {tool} and installed by {installer}, {org}",
          "title": "Provenance Template",
          "type": "string"
        },
        "tool": {
          "default": "fasta_gen",
          "title": "Tool",
          "type": "string"
        }
      },
      "title": "MetadataDocument",
      "type": "object"
    },
    "NamingDocument": {
      "additionalProperties": false,
      "description": "Grammar for canonical database names and FASTA filenames.",
      "properties": {
        "allowed_dbname_fields": {
          "default": [
            "project",
            "dbn",
            "description",
            "taxid"
          ],
          "items": {
            "type": "string"
          },
          "title": "Allowed Dbname Fields",
          "type": "array"
        },
        "date_format": {
          "default": "%Y%m%d",
          "title": "Date Format",
          "type": "string"
        },
        "dbname": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Dbname",
          "type": "object"
        },
        "decoy_token": {
          "default": "d",
          "title": "Decoy Token",
          "type": "string"
        },
        "default_dbname": {
          "default": "project",
          "title": "Default Dbname",
          "type": "string"
        },
        "description": {
          "$ref": "#/$defs/DescriptionDocument"
        },
        "entrapment_token": {
          "default": "e",
          "title": "Entrapment Token",
          "type": "string"
        },
        "extension": {
          "default": "fasta",
          "title": "Extension",
          "type": "string"
        },
        "filename": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Filename",
          "type": "object"
        },
        "separator": {
          "default": "_",
          "title": "Separator",
          "type": "string"
        }
      },
      "title": "NamingDocument",
      "type": "object"
    },
    "ShuffledEntrapmentDocument": {
      "additionalProperties": false,
      "description": "Request peptide-shuffled biological entrapment entries.",
      "properties": {
        "digestion": {
          "$ref": "#/$defs/DigestionDocument"
        },
        "fix_peptide_c_term": {
          "default": true,
          "title": "Fix Peptide C Term",
          "type": "boolean"
        },
        "fix_peptide_n_term": {
          "default": true,
          "title": "Fix Peptide N Term",
          "type": "boolean"
        },
        "fold": {
          "default": 1,
          "maximum": 10,
          "minimum": 1,
          "title": "Fold",
          "type": "integer"
        },
        "normalize_i_to_l": {
          "default": false,
          "title": "Normalize I To L",
          "type": "boolean"
        },
        "seed": {
          "default": 2000,
          "title": "Seed",
          "type": "integer"
        },
        "type": {
          "const": "shuffled",
          "default": "shuffled",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "ShuffledEntrapmentDocument",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Per-run sources, identity, destination, and explicit policy overrides.",
  "properties": {
    "annotation": {
      "default": "",
      "title": "Annotation",
      "type": "string"
    },
    "date": {
      "format": "date",
      "title": "Date",
      "type": "string"
    },
    "diagnostics": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Diagnostics"
    },
    "entrapment": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "foreign_species": "#/$defs/ForeignSpeciesEntrapmentDocument",
              "shuffled": "#/$defs/ShuffledEntrapmentDocument"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ShuffledEntrapmentDocument"
            },
            {
              "$ref": "#/$defs/ForeignSpeciesEntrapmentDocument"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entrapment"
    },
    "installer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Installer"
    },
    "metadata": {
      "anyOf": [
        {
          "$ref": "#/$defs/MetadataDocument"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "name_fields": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          }
        ]
      },
      "title": "Name Fields",
      "type": "object"
    },
    "naming": {
      "anyOf": [
        {
          "$ref": "#/$defs/NamingDocument"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "output_dir": {
      "format": "path",
      "title": "Output Dir",
      "type": "string"
    },
    "schema_version": {
      "const": "0.3",
      "default": "0.3",
      "title": "Schema Version",
      "type": "string"
    },
    "template": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Template"
    }
  },
  "required": [
    "output_dir",
    "date",
    "name_fields"
  ],
  "title": "DatabaseBuildRequestDocument",
  "type": "object"
}

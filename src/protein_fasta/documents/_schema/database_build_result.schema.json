{
  "$defs": {
    "BuildArtifactDocument": {
      "additionalProperties": false,
      "description": "One checksummed file participating in a database-build result.",
      "properties": {
        "byte_count": {
          "minimum": 0,
          "title": "Byte Count",
          "type": "integer"
        },
        "checksum": {
          "title": "Checksum",
          "type": "string"
        },
        "checksum_version": {
          "title": "Checksum Version",
          "type": "string"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        },
        "row_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Count"
        },
        "schema_name": {
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_name",
        "schema_version",
        "path",
        "checksum_version",
        "checksum",
        "byte_count"
      ],
      "title": "BuildArtifactDocument",
      "type": "object"
    },
    "ContaminantBlockDocument": {
      "additionalProperties": false,
      "description": "One named FASTA source inserted as a marked contaminant block.",
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "name",
        "path"
      ],
      "title": "ContaminantBlockDocument",
      "type": "object"
    },
    "DatabaseBuildCountsDocument": {
      "additionalProperties": false,
      "description": "Mutually reconcilable entry counts for one produced FASTA.",
      "properties": {
        "contaminant": {
          "minimum": 0,
          "title": "Contaminant",
          "type": "integer"
        },
        "decoy": {
          "minimum": 0,
          "title": "Decoy",
          "type": "integer"
        },
        "entrapment": {
          "minimum": 0,
          "title": "Entrapment",
          "type": "integer"
        },
        "target": {
          "minimum": 0,
          "title": "Target",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "target",
        "contaminant",
        "entrapment",
        "decoy",
        "total"
      ],
      "title": "DatabaseBuildCountsDocument",
      "type": "object"
    },
    "DatabaseBuildDecoyEvidenceDocument": {
      "additionalProperties": false,
      "description": "Decoy algorithm identity and collision outcomes.",
      "properties": {
        "dropped_peptides": {
          "minimum": 0,
          "title": "Dropped Peptides",
          "type": "integer"
        },
        "initial_collisions": {
          "minimum": 0,
          "title": "Initial Collisions",
          "type": "integer"
        },
        "mode": {
          "title": "Mode",
          "type": "string"
        },
        "omitted_decoys": {
          "minimum": 0,
          "title": "Omitted Decoys",
          "type": "integer"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "unresolved_collisions": {
          "minimum": 0,
          "title": "Unresolved Collisions",
          "type": "integer"
        }
      },
      "required": [
        "mode",
        "initial_collisions",
        "unresolved_collisions",
        "dropped_peptides",
        "omitted_decoys"
      ],
      "title": "DatabaseBuildDecoyEvidenceDocument",
      "type": "object"
    },
    "DatabaseBuildEntrapmentEvidenceDocument": {
      "additionalProperties": false,
      "description": "Entrapment strategy identity and achieved multiplicity.",
      "properties": {
        "achieved_fold": {
          "minimum": 0,
          "title": "Achieved Fold",
          "type": "integer"
        },
        "failures": {
          "minimum": 0,
          "title": "Failures",
          "type": "integer"
        },
        "proteins_affected": {
          "minimum": 0,
          "title": "Proteins Affected",
          "type": "integer"
        },
        "requested_fold": {
          "minimum": 1,
          "title": "Requested Fold",
          "type": "integer"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "source_proteins": {
          "minimum": 0,
          "title": "Source Proteins",
          "type": "integer"
        },
        "strategy": {
          "title": "Strategy",
          "type": "string"
        }
      },
      "required": [
        "strategy",
        "seed",
        "requested_fold",
        "achieved_fold",
        "failures",
        "proteins_affected",
        "source_proteins"
      ],
      "title": "DatabaseBuildEntrapmentEvidenceDocument",
      "type": "object"
    },
    "DatabaseBuildNormalizationDocument": {
      "additionalProperties": false,
      "description": "Exact input changes made before database assembly.",
      "properties": {
        "duplicates_dropped": {
          "minimum": 0,
          "title": "Duplicates Dropped",
          "type": "integer"
        },
        "terminal_stops_stripped": {
          "minimum": 0,
          "title": "Terminal Stops Stripped",
          "type": "integer"
        },
        "upper_cased": {
          "minimum": 0,
          "title": "Upper Cased",
          "type": "integer"
        }
      },
      "required": [
        "upper_cased",
        "terminal_stops_stripped",
        "duplicates_dropped"
      ],
      "title": "DatabaseBuildNormalizationDocument",
      "type": "object"
    },
    "DatabaseBuildSummaryDocument": {
      "additionalProperties": false,
      "description": "Sequence-length and amino-acid summary persisted with a build.",
      "properties": {
        "aa_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Aa Counts",
          "type": "object"
        },
        "aa_frequencies": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Aa Frequencies",
          "type": "object"
        },
        "length_max": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length Max"
        },
        "length_mean": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length Mean"
        },
        "length_median": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length Median"
        },
        "length_min": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length Min"
        },
        "length_q1": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length Q1"
        },
        "length_q3": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length Q3"
        },
        "n_sequences": {
          "minimum": 0,
          "title": "N Sequences",
          "type": "integer"
        },
        "total_residues": {
          "minimum": 0,
          "title": "Total Residues",
          "type": "integer"
        }
      },
      "required": [
        "n_sequences",
        "total_residues",
        "aa_counts",
        "aa_frequencies"
      ],
      "title": "DatabaseBuildSummaryDocument",
      "type": "object"
    },
    "DecoyDocument": {
      "additionalProperties": false,
      "description": "Validated decoy mode, stochastic seed, and collision digestion.",
      "properties": {
        "digestion": {
          "$ref": "#/$defs/DigestionDocument"
        },
        "mode": {
          "$ref": "#/$defs/DecoyMode",
          "default": "reverse"
        },
        "seed": {
          "default": 2000,
          "title": "Seed",
          "type": "integer"
        }
      },
      "title": "DecoyDocument",
      "type": "object"
    },
    "DecoyMode": {
      "description": "Supported protein-decoy generation algorithms.",
      "enum": [
        "reverse",
        "shuffle",
        "decoypyrat"
      ],
      "title": "DecoyMode",
      "type": "string"
    },
    "DescriptionDocument": {
      "additionalProperties": false,
      "description": "Rules for deriving a compact database-description token.",
      "properties": {
        "mode_flags": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Mode Flags",
          "type": "object"
        }
      },
      "title": "DescriptionDocument",
      "type": "object"
    },
    "DigestionDocument": {
      "additionalProperties": false,
      "description": "Peptide-length and missed-cleavage limits for one enzyme.",
      "properties": {
        "enzyme": {
          "default": "trypsin",
          "title": "Enzyme",
          "type": "string"
        },
        "max_length": {
          "default": 50,
          "minimum": 1,
          "title": "Max Length",
          "type": "integer"
        },
        "min_length": {
          "default": 7,
          "minimum": 1,
          "title": "Min Length",
          "type": "integer"
        },
        "missed_cleavages": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Missed Cleavages",
          "type": "integer"
        }
      },
      "title": "DigestionDocument",
      "type": "object"
    },
    "EffectiveDatabaseBuildDocument": {
      "additionalProperties": false,
      "description": "Fully resolved and directly replayable protein database build request.",
      "properties": {
        "annotation": {
          "default": "",
          "title": "Annotation",
          "type": "string"
        },
        "contaminant_blocks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContaminantBlockDocument"
          },
          "title": "Contaminant Blocks",
          "type": "array"
        },
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "decoy": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecoyDocument"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "diagnostics": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diagnostics"
        },
        "entrapment": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntrapmentDocument"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "foreign_sources": {
          "default": [],
          "items": {
            "format": "path",
            "type": "string"
          },
          "title": "Foreign Sources",
          "type": "array"
        },
        "installer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Installer"
        },
        "metadata": {
          "$ref": "#/$defs/MetadataDocument"
        },
        "name_fields": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "title": "Name Fields",
          "type": "object"
        },
        "naming": {
          "$ref": "#/$defs/NamingDocument"
        },
        "output_dir": {
          "format": "path",
          "title": "Output Dir",
          "type": "string"
        },
        "schema_version": {
          "const": "0.2",
          "default": "0.2",
          "title": "Schema Version",
          "type": "string"
        },
        "targets": {
          "items": {
            "format": "path",
            "type": "string"
          },
          "minItems": 1,
          "title": "Targets",
          "type": "array"
        },
        "template": {
          "title": "Template",
          "type": "string"
        }
      },
      "required": [
        "targets",
        "output_dir",
        "date",
        "name_fields",
        "template",
        "naming",
        "metadata"
      ],
      "title": "EffectiveDatabaseBuildDocument",
      "type": "object"
    },
    "EntrapmentDocument": {
      "additionalProperties": false,
      "description": "Entrapment strategy, multiplicity, seed, and collision digestion.",
      "properties": {
        "digestion": {
          "$ref": "#/$defs/DigestionDocument"
        },
        "fix_peptide_c_term": {
          "default": true,
          "title": "Fix Peptide C Term",
          "type": "boolean"
        },
        "fix_peptide_n_term": {
          "default": true,
          "title": "Fix Peptide N Term",
          "type": "boolean"
        },
        "fold": {
          "default": 1,
          "maximum": 10,
          "minimum": 1,
          "title": "Fold",
          "type": "integer"
        },
        "normalize_i_to_l": {
          "default": false,
          "title": "Normalize I To L",
          "type": "boolean"
        },
        "reject_shared_foreign": {
          "default": true,
          "title": "Reject Shared Foreign",
          "type": "boolean"
        },
        "seed": {
          "default": 2000,
          "title": "Seed",
          "type": "integer"
        },
        "strategy": {
          "$ref": "#/$defs/EntrapmentStrategy",
          "default": "shuffled"
        }
      },
      "title": "EntrapmentDocument",
      "type": "object"
    },
    "EntrapmentStrategy": {
      "description": "Supported entrapment generation algorithms.",
      "enum": [
        "shuffled",
        "foreign-species"
      ],
      "title": "EntrapmentStrategy",
      "type": "string"
    },
    "MetadataDocument": {
      "additionalProperties": false,
      "description": "Configured database metadata and contaminant-marker record grammar.",
      "properties": {
        "body_sequence": {
          "default": "CRAPCRAPCRAP",
          "title": "Body Sequence",
          "type": "string"
        },
        "date_format": {
          "default": "%Y-%m-%d",
          "title": "Date Format",
          "type": "string"
        },
        "id_namespace": {
          "default": "aa",
          "title": "Id Namespace",
          "type": "string"
        },
        "installer": {
          "default": "",
          "title": "Installer",
          "type": "string"
        },
        "marker_body_sequence": {
          "default": "MRECRAPCRAPCRAP",
          "title": "Marker Body Sequence",
          "type": "string"
        },
        "org": {
          "default": "fgcz",
          "title": "Org",
          "type": "string"
        },
        "provenance_template": {
          "default": "generated w {tool} and installed by {installer}, {org}",
          "title": "Provenance Template",
          "type": "string"
        },
        "tool": {
          "default": "fasta_gen",
          "title": "Tool",
          "type": "string"
        }
      },
      "title": "MetadataDocument",
      "type": "object"
    },
    "NamingDocument": {
      "additionalProperties": false,
      "description": "Grammar for canonical database names and FASTA filenames.",
      "properties": {
        "allowed_dbname_fields": {
          "default": [
            "project",
            "dbn",
            "description",
            "taxid"
          ],
          "items": {
            "type": "string"
          },
          "title": "Allowed Dbname Fields",
          "type": "array"
        },
        "date_format": {
          "default": "%Y%m%d",
          "title": "Date Format",
          "type": "string"
        },
        "dbname": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Dbname",
          "type": "object"
        },
        "decoy_token": {
          "default": "d",
          "title": "Decoy Token",
          "type": "string"
        },
        "default_dbname": {
          "default": "project",
          "title": "Default Dbname",
          "type": "string"
        },
        "description": {
          "$ref": "#/$defs/DescriptionDocument"
        },
        "entrapment_token": {
          "default": "e",
          "title": "Entrapment Token",
          "type": "string"
        },
        "extension": {
          "default": "fasta",
          "title": "Extension",
          "type": "string"
        },
        "filename": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Filename",
          "type": "object"
        },
        "separator": {
          "default": "_",
          "title": "Separator",
          "type": "string"
        }
      },
      "title": "NamingDocument",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Versioned machine-readable evidence for one completed database build.",
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/BuildArtifactDocument"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "counts": {
      "$ref": "#/$defs/DatabaseBuildCountsDocument"
    },
    "decoy": {
      "anyOf": [
        {
          "$ref": "#/$defs/DatabaseBuildDecoyEvidenceDocument"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "effective_request": {
      "$ref": "#/$defs/EffectiveDatabaseBuildDocument"
    },
    "entrapment": {
      "anyOf": [
        {
          "$ref": "#/$defs/DatabaseBuildEntrapmentEvidenceDocument"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "normalization": {
      "$ref": "#/$defs/DatabaseBuildNormalizationDocument"
    },
    "protein_fasta_version": {
      "title": "Protein Fasta Version",
      "type": "string"
    },
    "schema_version": {
      "const": "0.2",
      "default": "0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/DatabaseBuildSummaryDocument"
    }
  },
  "required": [
    "protein_fasta_version",
    "effective_request",
    "artifacts",
    "counts",
    "normalization",
    "summary"
  ],
  "title": "DatabaseBuildResultDocument",
  "type": "object"
}

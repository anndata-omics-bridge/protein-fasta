{
  "$defs": {
    "ContaminantBlockDocument": {
      "additionalProperties": false,
      "description": "One named FASTA source inserted as a marked contaminant block.",
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "name",
        "path"
      ],
      "title": "ContaminantBlockDocument",
      "type": "object"
    },
    "DecoyDocument": {
      "additionalProperties": false,
      "description": "Validated decoy mode, stochastic seed, and collision digestion.",
      "properties": {
        "digestion": {
          "$ref": "#/$defs/DigestionDocument"
        },
        "mode": {
          "$ref": "#/$defs/DecoyMode",
          "default": "reverse"
        },
        "seed": {
          "default": 2000,
          "title": "Seed",
          "type": "integer"
        }
      },
      "title": "DecoyDocument",
      "type": "object"
    },
    "DecoyMode": {
      "description": "Supported protein-decoy generation algorithms.",
      "enum": [
        "reverse",
        "shuffle",
        "decoypyrat"
      ],
      "title": "DecoyMode",
      "type": "string"
    },
    "DescriptionDocument": {
      "additionalProperties": false,
      "description": "Rules for deriving a compact database-description token.",
      "properties": {
        "mode_flags": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Mode Flags",
          "type": "object"
        }
      },
      "title": "DescriptionDocument",
      "type": "object"
    },
    "DigestionDocument": {
      "additionalProperties": false,
      "description": "Peptide-length and missed-cleavage limits for one enzyme.",
      "properties": {
        "enzyme": {
          "default": "trypsin",
          "title": "Enzyme",
          "type": "string"
        },
        "max_length": {
          "default": 50,
          "minimum": 1,
          "title": "Max Length",
          "type": "integer"
        },
        "min_length": {
          "default": 7,
          "minimum": 1,
          "title": "Min Length",
          "type": "integer"
        },
        "missed_cleavages": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Missed Cleavages",
          "type": "integer"
        }
      },
      "title": "DigestionDocument",
      "type": "object"
    },
    "EntrapmentDocument": {
      "additionalProperties": false,
      "description": "Entrapment strategy, multiplicity, seed, and collision digestion.",
      "properties": {
        "digestion": {
          "$ref": "#/$defs/DigestionDocument"
        },
        "fix_peptide_c_term": {
          "default": true,
          "title": "Fix Peptide C Term",
          "type": "boolean"
        },
        "fix_peptide_n_term": {
          "default": true,
          "title": "Fix Peptide N Term",
          "type": "boolean"
        },
        "fold": {
          "default": 1,
          "maximum": 10,
          "minimum": 1,
          "title": "Fold",
          "type": "integer"
        },
        "normalize_i_to_l": {
          "default": false,
          "title": "Normalize I To L",
          "type": "boolean"
        },
        "reject_shared_foreign": {
          "default": true,
          "title": "Reject Shared Foreign",
          "type": "boolean"
        },
        "seed": {
          "default": 2000,
          "title": "Seed",
          "type": "integer"
        },
        "strategy": {
          "$ref": "#/$defs/EntrapmentStrategy",
          "default": "shuffled"
        }
      },
      "title": "EntrapmentDocument",
      "type": "object"
    },
    "EntrapmentStrategy": {
      "description": "Supported entrapment generation algorithms.",
      "enum": [
        "shuffled",
        "foreign-species"
      ],
      "title": "EntrapmentStrategy",
      "type": "string"
    },
    "MetadataDocument": {
      "additionalProperties": false,
      "description": "Configured database metadata and contaminant-marker record grammar.",
      "properties": {
        "body_sequence": {
          "default": "CRAPCRAPCRAP",
          "title": "Body Sequence",
          "type": "string"
        },
        "date_format": {
          "default": "%Y-%m-%d",
          "title": "Date Format",
          "type": "string"
        },
        "id_namespace": {
          "default": "aa",
          "title": "Id Namespace",
          "type": "string"
        },
        "installer": {
          "default": "",
          "title": "Installer",
          "type": "string"
        },
        "marker_body_sequence": {
          "default": "MRECRAPCRAPCRAP",
          "title": "Marker Body Sequence",
          "type": "string"
        },
        "org": {
          "default": "fgcz",
          "title": "Org",
          "type": "string"
        },
        "provenance_template": {
          "default": "generated w {tool} and installed by {installer}, {org}",
          "title": "Provenance Template",
          "type": "string"
        },
        "tool": {
          "default": "fasta_gen",
          "title": "Tool",
          "type": "string"
        }
      },
      "title": "MetadataDocument",
      "type": "object"
    },
    "NamingDocument": {
      "additionalProperties": false,
      "description": "Grammar for canonical database names and FASTA filenames.",
      "properties": {
        "allowed_dbname_fields": {
          "default": [
            "project",
            "dbn",
            "description",
            "taxid"
          ],
          "items": {
            "type": "string"
          },
          "title": "Allowed Dbname Fields",
          "type": "array"
        },
        "date_format": {
          "default": "%Y%m%d",
          "title": "Date Format",
          "type": "string"
        },
        "dbname": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Dbname",
          "type": "object"
        },
        "decoy_token": {
          "default": "d",
          "title": "Decoy Token",
          "type": "string"
        },
        "default_dbname": {
          "default": "project",
          "title": "Default Dbname",
          "type": "string"
        },
        "description": {
          "$ref": "#/$defs/DescriptionDocument"
        },
        "entrapment_token": {
          "default": "e",
          "title": "Entrapment Token",
          "type": "string"
        },
        "extension": {
          "default": "fasta",
          "title": "Extension",
          "type": "string"
        },
        "filename": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Filename",
          "type": "object"
        },
        "separator": {
          "default": "_",
          "title": "Separator",
          "type": "string"
        }
      },
      "title": "NamingDocument",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Complete reproducible request for one protein database build.",
  "properties": {
    "add_decoys": {
      "default": true,
      "title": "Add Decoys",
      "type": "boolean"
    },
    "annotation": {
      "default": "",
      "title": "Annotation",
      "type": "string"
    },
    "contaminant_blocks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ContaminantBlockDocument"
      },
      "title": "Contaminant Blocks",
      "type": "array"
    },
    "date": {
      "format": "date",
      "title": "Date",
      "type": "string"
    },
    "decoy": {
      "$ref": "#/$defs/DecoyDocument"
    },
    "diagnostics": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Diagnostics"
    },
    "entrapment": {
      "anyOf": [
        {
          "$ref": "#/$defs/EntrapmentDocument"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "foreign_sources": {
      "default": [],
      "items": {
        "format": "path",
        "type": "string"
      },
      "title": "Foreign Sources",
      "type": "array"
    },
    "installer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Installer"
    },
    "metadata": {
      "$ref": "#/$defs/MetadataDocument"
    },
    "name_fields": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          }
        ]
      },
      "title": "Name Fields",
      "type": "object"
    },
    "naming": {
      "$ref": "#/$defs/NamingDocument"
    },
    "output_dir": {
      "format": "path",
      "title": "Output Dir",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "targets": {
      "items": {
        "format": "path",
        "type": "string"
      },
      "minItems": 1,
      "title": "Targets",
      "type": "array"
    },
    "template": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Template"
    }
  },
  "required": [
    "targets",
    "output_dir",
    "date",
    "name_fields"
  ],
  "title": "DatabaseBuildDocument",
  "type": "object"
}

{
  "$defs": {
    "AllProteomesDocument": {
      "additionalProperties": false,
      "description": "Select every UniProt proteome explicitly.",
      "properties": {
        "type": {
          "const": "all",
          "default": "all",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "AllProteomesDocument",
      "type": "object"
    },
    "ArtifactDocument": {
      "additionalProperties": false,
      "description": "One versioned, checksummed workflow artifact.",
      "properties": {
        "byte_count": {
          "minimum": 0,
          "title": "Byte Count",
          "type": "integer"
        },
        "checksum": {
          "minLength": 1,
          "title": "Checksum",
          "type": "string"
        },
        "checksum_version": {
          "minLength": 1,
          "title": "Checksum Version",
          "type": "string"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        },
        "row_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Count"
        },
        "schema_name": {
          "minLength": 1,
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_name",
        "schema_version",
        "path",
        "checksum_version",
        "checksum",
        "byte_count"
      ],
      "title": "ArtifactDocument",
      "type": "object"
    },
    "ProteomeQueryDocument": {
      "additionalProperties": false,
      "description": "Select proteomes using one explicit UniProt provider query.",
      "properties": {
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "type": {
          "const": "query",
          "default": "query",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "title": "ProteomeQueryDocument",
      "type": "object"
    },
    "ReferenceProteomesDocument": {
      "additionalProperties": false,
      "description": "Select the UniProt reference-proteome catalog.",
      "properties": {
        "type": {
          "const": "reference",
          "default": "reference",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "ReferenceProteomesDocument",
      "type": "object"
    },
    "UniProtCatalogRequestDocument": {
      "additionalProperties": false,
      "description": "Request one immutable local snapshot of the UniProt proteome catalog.",
      "properties": {
        "output_dir": {
          "format": "path",
          "title": "Output Dir",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "selection": {
          "discriminator": {
            "mapping": {
              "all": "#/$defs/AllProteomesDocument",
              "query": "#/$defs/ProteomeQueryDocument",
              "reference": "#/$defs/ReferenceProteomesDocument"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ReferenceProteomesDocument"
            },
            {
              "$ref": "#/$defs/AllProteomesDocument"
            },
            {
              "$ref": "#/$defs/ProteomeQueryDocument"
            }
          ],
          "title": "Selection"
        },
        "timeout_seconds": {
          "default": 120.0,
          "exclusiveMinimum": 0.0,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "output_dir"
      ],
      "title": "UniProtCatalogRequestDocument",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Machine-readable evidence for one completed proteome-catalog snapshot.",
  "properties": {
    "artifact": {
      "$ref": "#/$defs/ArtifactDocument"
    },
    "observed_releases": {
      "items": {
        "type": "string"
      },
      "title": "Observed Releases",
      "type": "array"
    },
    "protein_fasta_version": {
      "title": "Protein Fasta Version",
      "type": "string"
    },
    "provider_query": {
      "title": "Provider Query",
      "type": "string"
    },
    "provider_reported_counts": {
      "default": [],
      "items": {
        "type": "integer"
      },
      "title": "Provider Reported Counts",
      "type": "array"
    },
    "request": {
      "$ref": "#/$defs/UniProtCatalogRequestDocument"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "protein_fasta_version",
    "request",
    "provider_query",
    "retrieved_at",
    "observed_releases",
    "artifact"
  ],
  "title": "UniProtCatalogResultDocument",
  "type": "object"
}
